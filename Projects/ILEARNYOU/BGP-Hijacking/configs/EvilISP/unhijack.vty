! =============================================================================
! UNHIJACK.VTY - Stops the BGP hijack
! =============================================================================
! Run with: cat configs/EvilISP/unhijack.vty | docker exec -i clab-bgp-hijack-EvilISP vtysh
!
! This script removes the malicious announcement of 1.1.1.0/25,
! restoring traffic to its legitimate path via TorHost (AS 65001).
! =============================================================================

configure terminal
router bgp 65100
address-family ipv4 unicast
no network 1.1.1.0/25
exit-address-family
exit
exit